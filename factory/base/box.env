# shellcheck shell=bash
# How a factory box is started and what it may use. check-base.sh and ../box/build.sh source this file.
# Each value keeps what is already set in the environment, so `BOX_MEMORY=4g ./check-base.sh` works without editing.

: "${IMAGE:=factory-base}"
: "${BOX_MEMORY:=2g}"
: "${BOX_CPUS:=2}"

# Runner limits: at most BOX_CAP boxes at once, no new box below MIN_FREE_GIB of free disk
# (Docker has no disk limit per box), and the agent step is killed after AGENT_TIMEOUT.
: "${BOX_CAP:=4}"
: "${MIN_FREE_GIB:=5}"
: "${AGENT_TIMEOUT:=45m}"

# Skills from the repo's skills/ folder that every build box gets, space separated.
: "${BUILD_SKILLS:=review-rules}"

# Author of every commit made in a box. The GitHub noreply address keeps the real email out of history;
# build.sh adds a commit-msg hook in the box that puts Claude as co-author in every commit.
: "${BOX_GIT_NAME:=Gonçalo}"
: "${BOX_GIT_EMAIL:=9543211+goncalo-m-c@users.noreply.github.com}"

# Flags every box needs:
# - NET_ADMIN lets the entrypoint set the firewall as root; the box user never holds it.
# - no-new-privileges stops every process, also those started with `docker exec`, from gaining rights later.
# shellcheck disable=SC2034  # used by the scripts that source this file
BOX_FLAGS=(--cap-add NET_ADMIN --security-opt no-new-privileges --memory "$BOX_MEMORY" --cpus "$BOX_CPUS")
