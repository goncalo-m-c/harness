# shellcheck shell=bash
# How a factory box is started. The check script and the box runner source this file.
# Each value keeps what is already set in the environment, so `BOX_MEMORY=4g ./check-base.sh` works without editing.

: "${IMAGE:=factory-base}"
: "${BOX_MEMORY:=2g}"
: "${BOX_CPUS:=2}"

# Flags every box needs:
# - cap-drop ALL: no process in the box holds any capability, not even PID 1.
# - no-new-privileges stops every process, also those started with `docker exec`, from gaining rights later.
# shellcheck disable=SC2034  # used by the scripts that source this file
BOX_FLAGS=(--cap-drop ALL --security-opt no-new-privileges --memory "$BOX_MEMORY" --cpus "$BOX_CPUS")
