# shellcheck shell=bash
# How the factory uses a box. lib.sh sources this file after factory/base/box.env, which says how a box is started.
# Each value keeps what is already set in the environment, so `AGENT_TIMEOUT=90m ./build.sh 7` works without editing.

# At most BOX_CAP boxes at once, and the agent step is killed after AGENT_TIMEOUT.
: "${BOX_CAP:=4}"
: "${AGENT_TIMEOUT:=45m}"

# Skills from the repo's skills/ folder that every build box gets, space separated.
: "${BUILD_SKILLS:=review-rules}"

# Author of every commit made in a box. The GitHub noreply address keeps the real email out of history;
# build.sh adds a commit-msg hook that puts Claude as co-author in every commit.
: "${BOX_GIT_NAME:=Gonçalo}"
: "${BOX_GIT_EMAIL:=9543211+goncalo-m-c@users.noreply.github.com}"
